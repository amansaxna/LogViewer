{
  "name": "logviewer",
  "displayName": "LogViewer",
  "description": "High-performance structured log viewer, virtualized scrolling, live-tail, and jump-to-source navigation for VS Code.",
  "version": "1.0.0",
  "publisher": "amansaxna",
  "repository": {
    "type": "git",
    "url": "https://github.com/amansaxna/LogViewer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Other",
    "Formatters"
  ],
  "keywords": [
    "log",
    "logs",
    "logviewer",
    "viewer",
    "tail",
    "trace",
    "stacktrace",
    "virtualized"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:logviewer.editor",
    "onCommand:logviewer.open",
    "onCommand:logviewer.openCurrentFile",
    "onCommand:logviewer.openSourcesConfig",
    "onCommand:logviewer.openPresetsConfig"
  ],
  "contributes": {
    "configuration": {
      "title": "LogViewer",
      "properties": {
        "logviewer.defaultLogFile": {
          "type": "string",
          "default": "",
          "description": "Path to the default log file to open on launch (e.g. 'logs/app_workflow.log'). If empty, uses the source marked isDefault: true in config/log_sources.json."
        },
        "logviewer.sourcesConfigFile": {
          "type": "string",
          "default": "",
          "description": "Path to custom sources configuration JSON file. If empty, automatically checks .vscode/logviewer-sources.json and config/log_sources.json."
        },
        "logviewer.presetsConfigFile": {
          "type": "string",
          "default": "",
          "description": "Path to custom presets configuration JSON file. If empty, automatically checks .vscode/logviewer-presets.json and config/presets.json."
        }
      }
    },
    "commands": [
      {
        "command": "logviewer.open",
        "title": "Open LogViewer (Workspace Logs)",
        "category": "LogViewer",
        "icon": "$(file-text)"
      },
      {
        "command": "logviewer.openCurrentFile",
        "title": "Open Current File in LogViewer",
        "category": "LogViewer"
      },
      {
        "command": "logviewer.openSourcesConfig",
        "title": "Open Log Sources Configuration (JSON)",
        "category": "LogViewer"
      },
      {
        "command": "logviewer.openPresetsConfig",
        "title": "Open Log Presets Configuration (JSON)",
        "category": "LogViewer"
      }
    ],
    "customEditors": [
      {
        "viewType": "logviewer.editor",
        "displayName": "LogViewer",
        "selector": [
          {
            "filenamePattern": "*.log"
          },
          {
            "filenamePattern": "*.log.*"
          },
          {
            "filenamePattern": "*.txt"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "logviewer.open"
        },
        {
          "command": "logviewer.openCurrentFile"
        },
        {
          "command": "logviewer.openSourcesConfig"
        },
        {
          "command": "logviewer.openPresetsConfig"
        }
      ],
      "explorer/context": [
        {
          "command": "logviewer.openCurrentFile",
          "when": "resourceExtname == .log || resourceExtname == .txt",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "logviewer.openCurrentFile",
          "when": "resourceExtname == .log || resourceExtname == .txt",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}